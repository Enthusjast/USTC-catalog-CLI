{
  "name": "@enthusjast/ustc-catalog-cli",
  "version": "0.2.1",
  "description": "中国科学技术大学本科教务目录命令行客户端，支持课程、培养方案、教学班、教室、考试和替代课程查询",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enthusjast/USTC-catalog-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/Enthusjast/USTC-catalog-CLI/issues"
  },
  "homepage": "https://github.com/Enthusjast/USTC-catalog-CLI#readme",
  "keywords": [
    "ustc",
    "catalog",
    "cli",
    "course",
    "education",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "catalog": "dist/main.js",
    "catalog-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "guide.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "mcp:smoke": "npm run build && node scripts/mcp-smoke.mjs",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "prepack": "npm run build && node scripts/set-executable.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.10.0",
    "chalk": "^5.4.1",
    "cheerio": "^1.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "csv-stringify": "^6.5.2",
    "undici": "^7.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
